# Copy to .env for local development. Never commit real secrets.

# API (apps/api)
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# directConnection=true is required to reach the single-node replica set in Compose
MONGODB_URI=mongodb://localhost:27017/helpharbor?directConnection=true
REDIS_URL=redis://localhost:6379
# Sessions: idle timeout in minutes and hard limit in hours from sign-in
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=168
# Secure cookies need HTTPS; defaults to true when NODE_ENV=production
COOKIE_SECURE=false

# Inbound email webhook (POST /api/v1/inbound/email). Signed with HMAC-SHA256;
# leave empty to keep the webhook disabled (503). Generate: openssl rand -hex 32
INBOUND_WEBHOOK_SECRET=
# Mail for a workspace goes to <slug>@<domain>, replies to <slug>+<reply token>@<domain>
INBOUND_EMAIL_DOMAIN=inbound.helpharbor.example
INBOUND_SIGNATURE_TOLERANCE_SECONDS=300

# Seed (pnpm seed): password for every demo account, at least 12 characters.
# Left empty on purpose; the seed refuses to run until you choose one.
SEED_DEMO_PASSWORD=

# Web (apps/web) — server-side only; the browser never talks to MongoDB
API_BASE_URL=http://localhost:4000
