{
  "name": "helpharbor",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:local": "bash scripts/dev.sh",
    "check": "bash scripts/dev.sh check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "verify:mongo": "pnpm --filter @helpharbor/api verify:mongo"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@next/eslint-plugin-next": "^15.5.6",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
